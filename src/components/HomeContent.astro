---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getLangFromUrl } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

// Shared body for every locale's home page, so the markup exists once and the
// per-locale page files stay as thin routing shells.
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const principles = [
  {
    title: t('home.principles.capture.title'),
    body: t('home.principles.capture.body'),
  },
  {
    title: t('home.principles.structure.title'),
    body: t('home.principles.structure.body'),
  },
  {
    title: t('home.principles.review.title'),
    body: t('home.principles.review.body'),
  },
];
---

<section class="hero">
  <p class="hero__eyebrow">{t('home.hero.eyebrow')}</p>
  <h1>{t('home.hero.heading')}</h1>
  <p class="hero__body">{t('home.hero.body')}</p>
  <a class="button" href={getRelativeLocaleUrl(lang, 'method')}>{t('home.hero.cta')}</a>
</section>

<section class="section">
  <h2>{t('home.principles.heading')}</h2>
  <div class="card-grid">
    {
      principles.map((principle) => (
        <article class="card">
          <h3>{principle.title}</h3>
          <p>{principle.body}</p>
        </article>
      ))
    }
  </div>
</section>

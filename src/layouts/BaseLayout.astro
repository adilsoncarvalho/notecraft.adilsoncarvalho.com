---
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { defaultLang, getLangFromUrl, languages, localeKeys, stripLangFromPath } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { htmlLang, dir } = languages[lang];

const path = stripLangFromPath(Astro.url.pathname);
const canonical = new URL(Astro.url.pathname, Astro.site);
const pageTitle = title === t('site.title') ? title : `${title} — ${t('site.title')}`;
---

<!doctype html>
<html lang={htmlLang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* Tells search engines which URL serves which language for this page. */}
    {
      localeKeys.map((locale) => (
        <link
          rel="alternate"
          hreflang={languages[locale].htmlLang}
          href={getAbsoluteLocaleUrl(locale, path)}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl(defaultLang, path)} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={htmlLang.replace('-', '_')} />
    <meta name="twitter:card" content="summary" />

    <slot name="head" />
  </head>

  <body>
    <main>
      <slot />
    </main>

    <footer>
      <LanguageSwitcher lang={lang} />
    </footer>
  </body>
</html>
